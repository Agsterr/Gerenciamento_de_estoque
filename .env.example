# Variáveis de ambiente — Gerenciamento de Estoque (exemplo)
# Copie para .env e preencha antes de subir com Docker ou em desenvolvimento local.

# Banco de dados
DATABASE_URL=jdbc:postgresql://localhost:5432/estoque
DATABASE_USER=estoque
DATABASE_PASSWORD=

# Seed inicial (obrigatório na primeira subida para criar o usuário admin)
SEED_ADMIN_PASSWORD=

# Modo demonstração (opcional; sem DEMO_PASSWORD o botão demo fica desabilitado)
DEMO_ENABLED=true
DEMO_PASSWORD=

# Scripts de smoke test (test-api.ps1 / test-api.sh)
API_TEST_PASSWORD=
